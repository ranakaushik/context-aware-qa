# Copy to .env and fill in. Without a Gemini key the app runs in offline (extractive) mode.

# --- Google Gemini ---  key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Avoid the moving alias "gemini-flash-latest": in Oct 2026 it took minutes per answer. To pick another model, run
#   python -m qa_assistant.gemini_models
# and copy a name from the list (for example gemini-3-flash-preview or gemini-3.1-pro-preview).
GEMINI_MODEL=gemini-3.5-flash
# seconds before a Gemini call is abandoned (minimum 10)
GEMINI_TIMEOUT_S=60

# Retrieval: hybrid = keyword (BM25) + meaning-based search with Gemini embeddings, merged by rank
# (Gemini mode only; adds ~0.6 s per question) | keyword = BM25 only
QA_RETRIEVAL=hybrid
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Cosine similarity a section needs to count as a meaning match (off-topic questions score ~0.5)
QA_MIN_SIMILARITY=0.6

# auto = Gemini if GEMINI_API_KEY is set, otherwise offline | gemini | offline
QA_MODE=auto
# number of knowledge-base sections passed to the model
QA_TOP_K=5
# QA_KB_DIR=knowledge_base
