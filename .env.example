# Copy to .env and fill in. Without a Gemini key the app runs in offline (extractive) mode.

# --- Google Gemini ---  key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current Flash model. To pin a model, run
#   python -m qa_assistant.gemini_models
# and copy a name from the list (for example gemini-3-flash-preview or gemini-3.1-pro-preview).
GEMINI_MODEL=gemini-flash-latest

# auto = Gemini if GEMINI_API_KEY is set, otherwise offline | gemini | offline
QA_MODE=auto
# number of knowledge-base sections passed to the model
QA_TOP_K=5
# QA_KB_DIR=knowledge_base
